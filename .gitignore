# Virtual environment
.venv/

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/

# Model outputs - regenerated by every run, never committed
outputs/*
!outputs/.gitkeep

# Generated synthetic data - regenerated from the fixed seed in
# assumptions.yaml, so it is reproducible rather than stored.
#
# Ignore EVERYTHING here and allow the placeholder back, rather than
# listing extensions: a stage that one day writes a .json or a .png into
# this folder would otherwise be committed silently, which is how
# generated data ends up in a repository that says it holds none.
data/synthetic/*
!data/synthetic/.gitkeep

# OS and editor noise
Thumbs.db
.DS_Store
.vscode/
.idea/

# Excel lock files, created while a workbook is open
~$*.xlsx
~$*.xls

# Secrets. Nothing in this model needs one - every input is in YAML and
# nothing is fetched - but an ignored .env costs one line and a committed
# one cannot be taken back.
.env
.env.*
